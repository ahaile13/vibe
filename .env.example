# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Used by the daily cron that creates tonight's demo events.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string. Vercel sends it to the cron route automatically.
CRON_SECRET=make-a-long-random-string

# Optional: your production URL, used for login redirects and share links.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
